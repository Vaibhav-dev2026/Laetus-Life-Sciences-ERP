# Frontend environment variables (Vite)
# Copy this file to .env and fill in ALL values before running the dev server.
# NEVER commit the real .env file — it is gitignored.
# For Vercel deployment, set these in the Vercel dashboard under Project > Settings > Environment Variables.

# ── Backend API base URL ──────────────────────────────────────────────────────
# Local dev:   http://localhost:5000/api
# Production:  https://your-backend.onrender.com/api
# IMPORTANT: This MUST end with /api (no trailing slash).
#            axiosClient uses this as its baseURL and appends paths like /sales, /gst/gstr1 etc.
#            Do NOT add /api again in API call paths or you will get /api/api/... 404 errors.
VITE_API_BASE_URL=http://localhost:5000/api
