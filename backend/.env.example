# Backend environment variables
# Copy this file to .env and fill in ALL values before starting the server.
# NEVER commit the real .env file — it is gitignored.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Local dev:  mongodb://127.0.0.1:27017/laetus_erp
# Production: your MongoDB Atlas connection string from the Atlas dashboard
MONGO_URI=mongodb://127.0.0.1:27017/laetus_erp

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(48).toString('hex')|0 && process.stdout.write(require('crypto').randomBytes(48).toString('hex'))"
# or:            openssl rand -hex 48
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_HEX_STRING
JWT_EXPIRES_IN=8h

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local dev:   http://localhost:5173,http://127.0.0.1:5173
# Production:  https://your-frontend.vercel.app
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ── File storage (relative to backend/ directory) ────────────────────────────
# WARNING: On Render free tier, the local filesystem is ephemeral (reset on
# each deploy). Backups and uploads stored here will NOT persist between
# deploys. Use an external storage service (S3, Cloudinary, etc.) for
# durable file storage in production.
UPLOAD_DIR=uploads
BACKUP_DIR=backups

# ── Rate limiting ─────────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MIN=15

# ── Bootstrap admin (single-use seeding only) ─────────────────────────────────
# Used by bootstrapAuth.service.js to ensure the production admin account exists.
# Set these securely in your deployment environment — do NOT commit real values.
SEED_ADMIN_EMAIL=laetuslifesciences@gmail.com
SEED_ADMIN_PASSWORD=REPLACE_WITH_SECURE_ADMIN_PASSWORD

# ── Puppeteer PDF generation ──────────────────────────────────────────────────
# On Render/Linux: set to the installed Chromium binary path.
# render.yaml already sets this via buildCommand: apt-get install -y chromium
# Leave unset locally on Windows/Mac where Puppeteer's bundled Chromium works.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
